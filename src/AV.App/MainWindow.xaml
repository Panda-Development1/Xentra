<Window x:Class="AV.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AV.App.ViewModels"
        Title="Xentra AV" Height="700" Width="1100"
        Background="{StaticResource DarkBackground}"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/Logo.png"
        WindowState="Normal"
        MinHeight="500" MinWidth="800">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,24">
                    <TextBlock Text="XENTRA" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource NeonCyan}" FontFamily="Consolas"/>
                    <TextBlock Text="ANTIVIRUS" FontSize="11"
                               Foreground="{StaticResource NeonMagenta}" FontFamily="Consolas" Margin="0,-2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,16">
                    <Border Background="{StaticResource DarkBackground}" CornerRadius="6" Padding="10,8">
                        <StackPanel>
                            <TextBlock Text="SHIELD" FontSize="9" Foreground="{StaticResource NeonMagenta}"
                                       FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding ShieldStatus}" FontSize="11"
                                       FontFamily="Consolas" Margin="0,2,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding ShieldStatusColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Margin="12,0">
                    <Button Content="DASHBOARD" Click="Dashboard_Click"
                            Padding="12,10" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                            FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                    <Button Content="SCAN" Click="ScanView_Click"
                            Padding="12,10" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                            FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                    <Button Content="QUARANTINE" Click="QuarantineView_Click"
                            Padding="12,10" HorizontalContentAlignment="Left" Margin="0,0,0,4"
                            FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="20">
            <!-- Dashboard View -->
            <Grid Visibility="{Binding IsDashboardVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="DASHBOARD" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" Margin="0,0,0,20"/>

                <!-- Status Cards -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="9" Foreground="{StaticResource NeonMagenta}"
                                       FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="14" FontFamily="Consolas"
                                       Foreground="{StaticResource NeonGreen}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="QUARANTINED" FontSize="9" Foreground="{StaticResource NeonMagenta}"
                                       FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding QuarantineCount}" FontSize="28" FontFamily="Consolas"
                                       Foreground="{StaticResource NeonCyan}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="REAL-TIME SHIELD" FontSize="9" Foreground="{StaticResource NeonMagenta}"
                                       FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding ShieldStatus}" FontSize="14" FontFamily="Consolas" Margin="0,6,0,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{Binding ShieldStatusColor}"/>
                                </TextBlock.Foreground>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Quick Actions -->
                <Border Grid.Row="2" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="QUICK ACTIONS" FontSize="9" Foreground="{StaticResource NeonMagenta}"
                                   FontWeight="Bold" FontFamily="Consolas" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Scan File" Click="ScanFileButton_Click" Margin="0,0,8,0"
                                    FontFamily="Consolas" Padding="16,8"/>
                            <Button Content="Scan Directory" Click="ScanDirectoryButton_Click" Margin="0,0,8,0"
                                    FontFamily="Consolas" Padding="16,8"/>
                            <Button Content="View Quarantine" Click="QuarantineView_Click"
                                    FontFamily="Consolas" Padding="16,8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Recent Activity -->
                <Border Grid.Row="3" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="RECENT ACTIVITY" FontSize="9"
                                   Foreground="{StaticResource NeonMagenta}" FontWeight="Bold"
                                   FontFamily="Consolas" Margin="0,0,0,10"/>
                        <ListBox x:Name="ActivityList" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource NeonGreen}" FontFamily="Consolas" FontSize="11"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Scan View -->
            <Grid Visibility="{Binding IsScanVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="SCAN" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" Margin="0,0,0,20"/>

                <!-- Progress -->
                <Border Grid.Row="1" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{Binding ScanStatusText}" FontSize="13"
                                   Foreground="{StaticResource NeonGreen}" FontFamily="Consolas"/>

                        <ProgressBar Grid.Row="1" Value="{Binding ScanProgress}" Minimum="0" Maximum="100"
                                     Height="8" Margin="0,10,0,0"
                                     Foreground="{StaticResource NeonCyan}" Background="{StaticResource DarkBorder}"/>

                        <TextBlock Grid.Row="2" Text="{Binding CurrentScanFile}" FontSize="10"
                                   Foreground="{StaticResource NeonMagenta}" FontFamily="Consolas" Margin="0,6,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>

                <!-- Stats -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="FILES SCANNED" FontSize="9" Foreground="{StaticResource NeonMagenta}"
                                       FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding ScannedFiles}" FontSize="22" FontFamily="Consolas"
                                       Foreground="{StaticResource NeonCyan}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="THREATS" FontSize="9" Foreground="{StaticResource NeonMagenta}"
                                       FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock Text="{Binding ThreatsFound}" FontSize="22" FontFamily="Consolas"
                                       Foreground="#FF4444" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="4" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                            BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="PROGRESS" FontSize="9" Foreground="{StaticResource NeonMagenta}"
                                       FontWeight="Bold" FontFamily="Consolas"/>
                            <TextBlock FontSize="22" FontFamily="Consolas"
                                       Foreground="{StaticResource NeonGreen}" Margin="0,4,0,0">
                                <Run Text="{Binding ScanProgress, Mode=OneWay}"/>%
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Complete Summary -->
                <Border Grid.Row="3" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource NeonGreen}"
                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16"
                        Visibility="{Binding ScanComplete, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="{Binding ScanCompleteSummary}" FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource NeonGreen}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                </Border>

                <!-- Results -->
                <Border Grid.Row="4" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="RESULTS" FontSize="9"
                                   Foreground="{StaticResource NeonMagenta}" FontWeight="Bold"
                                   FontFamily="Consolas" Margin="0,0,0,8"/>
                        <ListBox ItemsSource="{Binding ScanResults}" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource NeonGreen}" FontFamily="Consolas" FontSize="11"/>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Quarantine View -->
            <Grid Visibility="{Binding isQuarantineVisible, Converter={StaticResource BoolToVisConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="QUARANTINE" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" Margin="0,0,0,20"/>

                <!-- Actions -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Refresh" Click="RefreshQuarantine_Click" Margin="0,0,8,0"
                            FontFamily="Consolas" Padding="16,8"/>
                    <Button Content="Restore" Click="RestoreQuarantine_Click" Margin="0,0,8,0"
                            FontFamily="Consolas" Padding="16,8"/>
                    <Button Content="Delete" Click="DeleteQuarantine_Click"
                            FontFamily="Consolas" Padding="16,8"/>
                </StackPanel>

                <!-- List -->
                <Border Grid.Row="2" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <DataGrid ItemsSource="{Binding QuarantineItems}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource NeonGreen}" FontFamily="Consolas" FontSize="11"
                              GridLinesVisibility="None" HeadersVisibility="Column"
                              SelectionMode="Single" SelectionChanged="QuarantineGrid_SelectionChanged"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="FILE" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="THREAT" Binding="{Binding ThreatName}" Width="180"/>
                            <DataGridTextColumn Header="DATE" Binding="{Binding QuarantinedAt}" Width="160"/>
                            <DataGridTextColumn Header="PATH" Binding="{Binding OriginalPath}" Width="250"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
