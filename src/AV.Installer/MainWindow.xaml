<Window x:Class="AV.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XENTRA AV INSTALLER" Height="600" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Icon="Assets/Logo.png"
        ResizeMode="NoResize">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="NeonTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource DarkBackground}" BorderBrush="{StaticResource NeonCyan}"
            BorderThickness="2" CornerRadius="12">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR -->
            <Border Grid.Column="0" Background="{StaticResource DarkPanel}"
                    BorderBrush="{StaticResource DarkBorder}" BorderThickness="0,0,1,0"
                    CornerRadius="12,0,0,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Logo -->
                    <StackPanel Grid.Row="0" Margin="24,30,24,30">
                        <TextBlock Text="XENTRA" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource NeonCyan}" FontFamily="Consolas"
                                   HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource NeonCyanColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="ANTIVIRUS" FontSize="14" Foreground="{StaticResource NeonMagenta}"
                                   FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                        <TextBlock x:Name="VersionText" Text="v1.0.0" FontSize="11"
                                   Foreground="{StaticResource DarkBorder}" FontFamily="Consolas"
                                   HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Step indicators -->
                    <StackPanel Grid.Row="1" Margin="24,0">
                        <Border x:Name="Step1Border" Background="#1A00F0FF" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="{StaticResource NeonCyan}" Margin="0,0,10,0"/>
                                <TextBlock Text="WELCOME" Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Step2Border" Background="Transparent" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Step2Dot" Width="10" Height="10" Fill="{StaticResource DarkBorder}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="Step2Text" Text="LOCATION" Foreground="{StaticResource DarkBorder}" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Step3Border" Background="Transparent" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Step3Dot" Width="10" Height="10" Fill="{StaticResource DarkBorder}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="Step3Text" Text="INSTALL" Foreground="{StaticResource DarkBorder}" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="Step4Border" Background="Transparent" CornerRadius="8" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Step4Dot" Width="10" Height="10" Fill="{StaticResource DarkBorder}" Margin="0,0,10,0"/>
                                <TextBlock x:Name="Step4Text" Text="COMPLETE" Foreground="{StaticResource DarkBorder}" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Update button at bottom -->
                    <Button x:Name="UpdateButton" Grid.Row="2" Content="CHECK UPDATES"
                            Click="UpdateButton_Click" Margin="24,0,24,24" Padding="10,10"
                            Background="{StaticResource DarkBorder}" Foreground="{StaticResource NeonGreen}"
                            FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                            BorderThickness="1" BorderBrush="{StaticResource NeonGreen}"/>
                </Grid>
            </Border>

            <!-- RIGHT CONTENT -->
            <Grid Grid.Column="1">
                <!-- Close button -->
                <Button Content="X" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="32" Height="32" Margin="0,12,16,0" Click="CloseButton_Click"
                        Background="Transparent" Foreground="{StaticResource DarkBorder}"
                        FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"/>

                <!-- STEP 1: Welcome -->
                <Grid x:Name="Step1Panel" Visibility="Visible" Margin="40,30,40,30">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="XENTRA" FontSize="52" FontWeight="Bold"
                                   Foreground="{StaticResource NeonCyan}" FontFamily="Consolas"
                                   HorizontalAlignment="Center">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource NeonCyanColor}" BlurRadius="30" ShadowDepth="0" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="ANTIVIRUS SYSTEM" FontSize="18" Foreground="{StaticResource NeonMagenta}"
                                   FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,4,0,30"/>

                        <TextBlock Text="Real-time protection against malware" Foreground="{StaticResource DarkBorder}"
                                   FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Signature-based threat detection" Foreground="{StaticResource DarkBorder}"
                                   FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Automatic quarantine system" Foreground="{StaticResource DarkBorder}"
                                   FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Cyberpunk-grade security" Foreground="{StaticResource DarkBorder}"
                                   FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <Button x:Name="BeginButton" Content="BEGIN INSTALLATION" Click="BeginButton_Click"
                                HorizontalAlignment="Center" Padding="40,14"
                                Background="{StaticResource DarkBorder}" Foreground="{StaticResource NeonCyan}"
                                FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                BorderThickness="2" BorderBrush="{StaticResource NeonCyan}" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 2: Location -->
                <Grid x:Name="Step2Panel" Visibility="Collapsed" Margin="40,30,40,30">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="INSTALLATION LOCATION" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" Margin="0,0,0,20"/>

                        <Border Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="Select installation directory" Foreground="{StaticResource DarkBorder}"
                                           FontFamily="Consolas" FontSize="11" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="InstallPathBox" Grid.Column="0" Text="C:\Program Files\XentraAV"
                                             Background="{StaticResource DarkBackground}" Foreground="{StaticResource NeonGreen}"
                                             FontFamily="Consolas" Padding="10,8" BorderThickness="1"
                                             BorderBrush="{StaticResource DarkBorder}" IsReadOnly="True" FontSize="13"/>
                                    <Button Grid.Column="1" Content="BROWSE" Click="BrowseButton_Click"
                                            Background="{StaticResource DarkBorder}" Foreground="{StaticResource NeonCyan}"
                                            FontFamily="Consolas" Padding="16,8" Margin="10,0,0,0"
                                            BorderThickness="1" BorderBrush="{StaticResource NeonCyan}" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="EXTRAS" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource NeonMagenta}" FontFamily="Consolas" Margin="0,0,0,12"/>

                        <CheckBox x:Name="PinToTaskbarCheckBox" Content="Pin to Windows taskbar"
                                  Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" FontSize="13"
                                  IsChecked="True" Margin="0,0,0,10"/>
                        <CheckBox x:Name="DesktopShortcutCheckBox" Content="Create desktop shortcut"
                                  Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" FontSize="13"
                                  IsChecked="True" Margin="0,0,0,30"/>

                        <Button Content="CONTINUE" Click="ContinueButton_Click"
                                HorizontalAlignment="Right" Padding="30,12"
                                Background="{StaticResource NeonCyan}" Foreground="{StaticResource DarkBackground}"
                                FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- STEP 3: Installing -->
                <Grid x:Name="Step3Panel" Visibility="Collapsed" Margin="40,30,40,30"
                      IsVisibleChanged="Step3Panel_IsVisibleChanged">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="INSTALLING" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" Margin="0,0,0,8"/>
                        <TextBlock x:Name="InstallStatusText" Text="Preparing installation..."
                                   Foreground="{StaticResource DarkBorder}" FontFamily="Consolas" FontSize="12" Margin="0,0,0,20"/>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="InstallProgress" Grid.Column="0" Height="10" Minimum="0" Maximum="100"
                                         Foreground="{StaticResource NeonCyan}" Background="{StaticResource DarkBorder}"/>
                            <TextBlock x:Name="PercentText" Grid.Column="1" Text="0%"
                                       Foreground="{StaticResource NeonMagenta}" FontFamily="Consolas"
                                       FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>

                        <Border Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                                BorderThickness="1" CornerRadius="8" Padding="10" Height="200">
                            <ScrollViewer x:Name="LogScroller" VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="LogText" Foreground="{StaticResource NeonGreen}"
                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- STEP 4: Complete -->
                <Grid x:Name="Step4Panel" Visibility="Collapsed" Margin="40,30,40,30">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="INSTALLATION COMPLETE" FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource NeonGreen}" FontFamily="Consolas"
                                   HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource NeonGreenColor}" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="CompletePathText" Text="Installed to: C:\Program Files\XentraAV"
                                   Foreground="{StaticResource DarkBorder}" FontFamily="Consolas"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                        <Button x:Name="LaunchButton" Content="LAUNCH XENTRA" Click="LaunchButton_Click"
                                HorizontalAlignment="Center" Padding="40,14"
                                Background="{StaticResource NeonGreen}" Foreground="{StaticResource DarkBackground}"
                                FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                BorderThickness="0" Cursor="Hand" Margin="0,0,0,12"/>

                        <Button Content="CLOSE" Click="CloseButton_Click"
                                HorizontalAlignment="Center" Padding="30,10"
                                Background="{StaticResource DarkBorder}" Foreground="{StaticResource NeonCyan}"
                                FontFamily="Consolas" FontSize="13"
                                BorderThickness="1" BorderBrush="{StaticResource NeonCyan}" Cursor="Hand"/>
                    </StackPanel>
                </Grid>

                <!-- Update overlay -->
                <Border x:Name="UpdateOverlay" Visibility="Collapsed"
                        Background="#CC05050A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">
                        <TextBlock Text="CHECKING FOR UPDATES..." FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource NeonCyan}" FontFamily="Consolas"
                                   HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock x:Name="UpdateStatusText" Text="Connecting to GitHub..."
                                   Foreground="{StaticResource DarkBorder}" FontFamily="Consolas"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <ProgressBar x:Name="UpdateProgress" Height="6" Width="300"
                                     Foreground="{StaticResource NeonGreen}" Background="{StaticResource DarkBorder}"
                                     HorizontalAlignment="Center" Margin="0,0,0,20" Visibility="Collapsed"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="DownloadUpdateButton" Content="DOWNLOAD UPDATE" Click="DownloadUpdateButton_Click"
                                    Visibility="Collapsed" Padding="20,10"
                                    Background="{StaticResource NeonGreen}" Foreground="{StaticResource DarkBackground}"
                                    FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                    BorderThickness="0" Margin="0,0,10,0"/>
                            <Button Content="SKIP" Click="SkipUpdateButton_Click"
                                    Padding="20,10"
                                    Background="Transparent" Foreground="{StaticResource DarkBorder}"
                                    FontFamily="Consolas" FontSize="13"
                                    BorderThickness="1" BorderBrush="{StaticResource DarkBorder}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
