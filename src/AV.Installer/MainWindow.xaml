<Window x:Class="AV.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xentra AV Installer" Height="500" Width="600"
        Background="{StaticResource DarkBackground}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="XENTRA AV INSTALLER" FontSize="28" FontWeight="Bold"
                   Foreground="{StaticResource NeonMagenta}" FontFamily="Consolas"
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <Border Grid.Row="1" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Install Location" Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" FontWeight="Bold"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InstallPathBox" Grid.Column="0" Text="C:\Program Files\XentraAV"
                             Background="{StaticResource DarkBorder}" Foreground="{StaticResource NeonGreen}"
                             FontFamily="Consolas" Padding="8,6" BorderThickness="1"
                             BorderBrush="{StaticResource DarkBorder}" IsReadOnly="True"/>
                    <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="BrowseButton_Click"
                            Background="{StaticResource DarkBorder}" Foreground="{StaticResource NeonCyan}"
                            FontFamily="Consolas" Padding="12,6" Margin="8,0,0,0" BorderThickness="1"
                            BorderBrush="{StaticResource NeonCyan}"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <CheckBox x:Name="PinToTaskbarCheckBox" Content="Pin to taskbar"
                      Foreground="{StaticResource NeonCyan}" FontFamily="Consolas" Margin="0,0,16,0"/>
            <CheckBox x:Name="DesktopShortcutCheckBox" Content="Create desktop shortcut"
                      Foreground="{StaticResource NeonCyan}" FontFamily="Consolas"/>
        </StackPanel>

        <ProgressBar x:Name="InstallProgress" Grid.Row="3" Height="8" Minimum="0" Maximum="100"
                     Foreground="{StaticResource NeonMagenta}" Background="{StaticResource DarkBorder}"
                     Margin="0,0,0,12"/>

        <Border Grid.Row="4" Background="{StaticResource DarkPanel}" BorderBrush="{StaticResource DarkBorder}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer x:Name="LogScroller">
                <TextBlock x:Name="LogText" Foreground="{StaticResource NeonGreen}" FontFamily="Consolas"
                           FontSize="11" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Border>

        <Button x:Name="InstallButton" Grid.Row="5" Content="INSTALL" Click="InstallButton_Click"
                HorizontalAlignment="Center" Margin="0,12,0,0" Padding="40,12"
                Background="{StaticResource DarkBorder}" Foreground="{StaticResource NeonMagenta}"
                FontFamily="Consolas" FontSize="16" FontWeight="Bold" BorderThickness="2"
                BorderBrush="{StaticResource NeonMagenta}"/>

        <TextBlock Grid.Row="6" Text="Requires Administrator" Foreground="{StaticResource DarkBorder}"
                   FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </Grid>
</Window>
