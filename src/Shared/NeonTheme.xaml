<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="NeonCyanColor">#00FFFF</Color>
    <Color x:Key="NeonMagentaColor">#FF00FF</Color>
    <Color x:Key="NeonGreenColor">#39FF14</Color>
    <Color x:Key="DarkBackgroundColor">#0A0A0F</Color>
    <Color x:Key="DarkPanelColor">#12121A</Color>
    <Color x:Key="DarkBorderColor">#2A2A3A</Color>

    <SolidColorBrush x:Key="NeonCyan" Color="{StaticResource NeonCyanColor}"/>
    <SolidColorBrush x:Key="NeonMagenta" Color="{StaticResource NeonMagentaColor}"/>
    <SolidColorBrush x:Key="NeonGreen" Color="{StaticResource NeonGreenColor}"/>
    <SolidColorBrush x:Key="DarkBackground" Color="{StaticResource DarkBackgroundColor}"/>
    <SolidColorBrush x:Key="DarkPanel" Color="{StaticResource DarkPanelColor}"/>
    <SolidColorBrush x:Key="DarkBorder" Color="{StaticResource DarkBorderColor}"/>

    <FontFamily x:Key="MonoFont">Consolas, Courier New</FontFamily>

    <DropShadowEffect x:Key="NeonGlowEffect"
                      Color="{StaticResource NeonCyanColor}"
                      BlurRadius="12" ShadowDepth="0" Opacity="0.8"/>

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{StaticResource NeonGreen}"/>
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Background" Value="{StaticResource DarkBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource NeonCyan}"/>
        <Setter Property="BorderBrush" Value="{StaticResource NeonCyan}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="Background" Value="{StaticResource DarkBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource NeonCyan}"/>
        <Setter Property="Height" Value="6"/>
    </Style>

    <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource DarkBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

</ResourceDictionary>
